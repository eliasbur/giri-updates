CHAT_TOKEN=
CHAT_ENDPOINT=

# One of the following per repo is required:
#
# GitLab backend:
GITLAB_MYPROJECT_TOKEN=
GITLAB_MYPROJECT_PATH=group/subgroup/project
GITLAB_MYPROJECT_LOCAL_PATH=.
#
# GitHub backend:
# GITHUB_MYPROJECT_TOKEN=
# GITHUB_MYPROJECT_PATH=owner/myproject
# GITHUB_MYPROJECT_LOCAL_PATH=.

# Required: prefix for agent-created branches
AGENT_BRANCH_PREFIX=agent/jcode
# Optional: override target branch (default: development)
# TARGET_BRANCH=development
# Optional: GitHub/GitLab username to assign as reviewer on created MRs/PRs
# ASSIGNEE=username