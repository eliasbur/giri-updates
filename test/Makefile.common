##===- giri/test/UnitTests/Makefile.common -----------------*- Makefile -*-===##
#

########################### User defined variables ###########################
NAME ?= main
DEBUGFLAGS ?=
GIRI_DIR ?= ../../../build/
BuildMode ?= Release+Debug+Asserts
SRC_FILES ?= $(wildcard *.c)
IR_FILES ?= $(SRC_FILES:%.c=%.bc)
INPUT ?=
CRITERION ?=
TEST_ANS ?= ans-inst.txt
MAPPING ?=
# EXPECTED_EXIT: expected exit code of traced binary (default -1: non-zero exit fails the stage; set to N to pass only on that exit, or set EXIT_UNCHECKED=1 to skip checking entirely for UB)
EXPECTED_EXIT ?= -1
# EXIT_UNCHECKED: set to 1 when exit code is inherently unpredictable (UB, platform-dependent)
EXIT_UNCHECKED ?= 0

################# Dont' edit the following lines accidently ##################
CC = clang
CXX = clang++
# -Wno-error=implicit-function-declaration: from Clang 15, an implicit
# function declaration (calling a function before any prototype, as
# test/UnitTests/test20/even.c does with is_odd) is a hard error by
# default; 14.0.0 (and the 3.4-era reference) compiled it with a
# warning. The flag restores that behavior for the C sources without
# touching the test cases. (No-op for the C++ sources, where implicit
# declarations are already an error and none of the tests use them.)
CFLAGS += -g -O0 -c -emit-llvm -Wno-error=implicit-function-declaration
# -Xclang -no-opaque-pointers: from LLVM 15, clang emits IR with *opaque*
# pointers by default; 14.0.0 (and the 3.4-era reference) emitted *typed*
# pointers (i32*, i8**...). The 3.4 goldens are typed-pointer-based, and the
# opaque IR changes the program structure the backward slice traverses (the
# kmeans slice drifted from the golden: 61/240/279 vs 222/276). The flag
# restores typed-pointer emit so the numbered IR matches the reference.
# (Passthrough form: in 15.0.0 the flag is a cc1 flag, not a driver flag.)
CFLAGS += -Xclang -no-opaque-pointers
GIRI_LIB_DIR = $(GIRI_DIR)/lib
GIRI_BIN_DIR = $(GIRI_DIR)/bin

# New pass manager harness (LLVM 15.0.0). Each Giri library is loaded twice:
#   -load registers the cl::opt globals (-trace-file, -slice-file, -criterion-*,
#       -dump-bbid, -mapping-*, ...) BEFORE opt parses the command line;
#   -load-pass-plugin registers the -passes pipeline names AFTER parsing.
# The pipeline shape is unchanged from the legacy PM: the function pass
# mergereturn is wrapped in an explicit function(...) sub-pipeline (it must be
# first, fixing the top-level element type), and every Giri pass is a module
# pass at the top level. -enable-new-pm=0 and the legacy -<passname> flags are
# gone; the cl::opt flags (-trace-file, -slice-file, criterion-*) are kept.
GIRI_LOAD = -load $(GIRI_LIB_DIR)/libdgutility.so -load $(GIRI_LIB_DIR)/libgiri.so
GIRI_LOAD_PLUGINS = -load-pass-plugin=$(GIRI_LIB_DIR)/libdgutility.so -load-pass-plugin=$(GIRI_LIB_DIR)/libgiri.so

# Keep trace artifacts around for post-mortem when a stage fails
.PRECIOUS: $(NAME).trace

.PHONY: all lib
all: lib $(NAME).slice.loc

lib:
	$(MAKE) -s -C $(GIRI_DIR)

%.slice.loc: %.slice
	@ sed -n '/^Source.*[0-9]\+$$/p' $< |\
		awk -F: '{print $$3}' |\
		sort -g |\
		uniq > $@

$(NAME).slice : $(NAME).all.bc $(NAME).trace
	opt $(GIRI_LOAD) $(GIRI_LOAD_PLUGINS) \
		-passes="function(mergereturn),bbnum,lsnum,dgiri,remove-bbnum,remove-lsnum" \
		-trace-file=$(NAME).trace -slice-file=$(NAME).slice $(CRITERION)\
		-stats $(DEBUGFLAGS) $< -o /dev/null

$(NAME).trace: $(NAME).trace.exe
ifeq (1,$(EXIT_UNCHECKED))
	@ ./$< $(INPUT) 2>$(NAME).trace.err; \
		if grep -q '\[GIRI\] Abnormal termination' $(NAME).trace.err; then \
			cat $(NAME).trace.err; \
			echo "Traced binary terminated abnormally"; \
			exit 1; \
		fi; \
		cat $(NAME).trace.err
else
	@ ./$< $(INPUT) 2>$(NAME).trace.err; _rc=$$?; \
		if grep -q '\[GIRI\] Abnormal termination' $(NAME).trace.err; then \
			cat $(NAME).trace.err; \
			echo "Traced binary terminated abnormally"; \
			exit 1; \
		fi; \
		cat $(NAME).trace.err; \
		if [ "$(EXPECTED_EXIT)" != "-1" ] && [ "$$_rc" -ne "$(EXPECTED_EXIT)" ]; then \
			echo "Exit status $$_rc does not match expected $(EXPECTED_EXIT)"; \
			exit 1; \
		fi; \
		if [ "$(EXPECTED_EXIT)" = "-1" ] && [ "$$_rc" -ne 0 ]; then \
			exit $$_rc; \
		fi
endif

# -no-pie: from LLVM 15, clang links position-independent executables by
# default (and assembles .s with -mrelocation-model pic), but `llc -O0`
# emits *static-model* asm whose absolute .rodata reference is an
# R_X86_64_32S relocation a PIE link rejects. 14.0.0 (and the 3.4
# reference) linked the traced exe non-PIE, so -no-pie restores the
# proven link model. Applied at link only; the .s (and its numbering)
# is untouched.
$(NAME).trace.exe : $(NAME).trace.s
	$(CXX) -fno-strict-aliasing -no-pie $+ -o $@ -L$(GIRI_LIB_DIR) -lrtgiri $(LDFLAGS)

$(NAME).trace.s : $(NAME).trace.bc
	llc -asm-verbose=false -O0 $< -o $@

$(NAME).trace.bc : $(NAME).all.bc
	opt $(GIRI_LOAD) $(GIRI_LOAD_PLUGINS) \
		-passes="function(mergereturn),bbnum,lsnum,trace-giri,remove-bbnum,remove-lsnum" \
		-trace-file=$(NAME).trace \
		-stats $(DEBUGFLAGS) $< -o $@

$(NAME).all.bc: $(IR_FILES)
	llvm-link $^ -o $@
$(IR_FILES) : %.bc : %.c
	$(CC) $(CFLAGS) $+ -o $@

.PHONY: mapping bbid bbid

mapping: $(NAME).all.bc
	opt $(GIRI_LOAD) $(GIRI_LOAD_PLUGINS) \
		-passes="function(mergereturn),srcline-mapping" \
		$(MAPPING) \
		-stats $(DEBUGFLAGS) $< -o /dev/null

bbid: $(NAME).all.bc
	opt $(GIRI_LOAD) $(GIRI_LOAD_PLUGINS) \
		-passes="function(mergereturn),bbnum,remove-bbnum" \
		-dump-bbid=true \
		-stats $(DEBUGFLAGS) $< -o /dev/null 2>&1 |\
		view -

lsid: $(NAME).all.bc
	opt $(GIRI_LOAD) $(GIRI_LOAD_PLUGINS) \
		-passes="function(mergereturn),lsnum,remove-lsnum" \
		-dump-lsid=true \
		-stats $(DEBUGFLAGS) $< -o /dev/null 2>&1 |\
		view -

%.ll : %.bc
	llvm-dis $< -o $@

.PHONY: test ptrace rebuild clean clean-all

test: $(NAME).slice.loc
	diff $< $(TEST_ANS)

prtrace: $(NAME).trace
	$(GIRI_BIN_DIR)/prtrace $< | view -

rebuild: clean all

clean: clean-all
	@ rm -f *.ll *.bc *.o *.s *.slice *.slice.loc *.exe *.trace *.trace.err ans.txt core.*
# Note: each benchmark's own runtime output file (e.g., matrix_multiply's matrix_file_out_serial.txt)
# is deliberately not matched by clean: — it is program output, not a build artifact.
clean-all:
